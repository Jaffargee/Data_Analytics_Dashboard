# Copy this file to .env and fill in real values.
# Until POS4AFRICA_BASE_URL and POS4AFRICA_API_KEY are both set, the service
# runs in stub mode: it validates and logs sales but does not send them
# anywhere real. See app/services/pos4africa_client.py.

POS4AFRICA_BASE_URL=
POS4AFRICA_API_KEY=

# Comma-separated list is NOT supported here (pydantic-settings reads this as
# a JSON list) — edit ALLOWED_ORIGINS in app/config.py directly if you need
# to add your deployed dashboard's origin.
