# Copy to .env and fill in.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The FastAPI sales-bridge backend the /pos page talks to (see backend/).
# Defaults to http://localhost:8000 if unset — only needed once you're
# running the backend somewhere else (a deployed URL, a different port).
VITE_SALES_API_URL=http://localhost:8000
